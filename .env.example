# Server
NODE_ENV=production
PORT=4000
FRONTEND_URL=https://YOUR-FRONTEND.vercel.app
# Multiple domains: FRONTEND_URLS=https://a.vercel.app,https://b.example.com

# JWT - create a long random secret
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# PostgreSQL / Supabase
POSTGRES_HOST=YOUR_SUPABASE_DB_HOST
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=YOUR_SUPABASE_DB_PASSWORD
POSTGRES_DB=postgres
POSTGRES_SCHEMA=tenant_master
POSTGRES_SSL=true
POSTGRES_SYNCHRONIZE=true
POSTGRES_POOL_MAX=5
POSTGRES_IDLE_TIMEOUT_MS=30000
POSTGRES_CONNECTION_TIMEOUT_MS=10000

# LiveKit Cloud
LIVEKIT_URL=wss://YOUR-PROJECT.livekit.cloud
LIVEKIT_API_KEY=YOUR_LIVEKIT_API_KEY
LIVEKIT_API_SECRET=YOUR_LIVEKIT_API_SECRET
